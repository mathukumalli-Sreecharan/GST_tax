SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
CORS_ORIGINS=http://localhost:3000

# Backend only. Use the Supabase project origin, without /rest/v1.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-or-secret-key
ADMIN_USER_ID=your-email-verified-supabase-auth-user-uuid
ADMIN_NOTIFICATION_EMAIL=mathukumalli.sreecharan@gmail.com
RESEND_API_KEY=your-server-only-resend-key
EMAIL_FROM=GST Ledger Studio <onboarding@resend.dev>
APP_BASE_URL=http://localhost:3000
APP_ENV=development
# History uses the private generated-excel-files bucket created by migration 003.
# Run python -m backend.maintenance on a durable schedule (Render cron supplied).

# Temporary Resend HTTP diagnostics (disable after investigation).
# RESEND_DIAGNOSTICS=1
# Optional full SHA-256 digest of the expected trimmed API key; never the key itself.
# RESEND_EXPECTED_KEY_SHA256=

# Durable verification sessions (migration 007, applied manually).
# Production defaults to supabase and refuses sqlite. No new backend service key.
# REVIEW_BACKEND=supabase
# Local development/test only: REVIEW_BACKEND=sqlite
# REVIEW_STORE_PATH=backend/.tmp/reviews.sqlite3
# Edge cleanup only: configure a separate >=32-character REVIEW_CLEANUP_SECRET
# in Supabase Edge secrets + its cron invoker; NEVER in NEXT_PUBLIC_* variables.
